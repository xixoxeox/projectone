# Copy to .env for local development. Replace every development secret.
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_BASE_PATH=/api/v1
POSTGRES_DB=screener
POSTGRES_USER=screener
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://screener:replace-with-a-local-password@db:5432/screener
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=swing-trading-screener
JWT_AUDIENCE=swing-trading-screener-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER=replace-with-an-independent-random-secret
REFRESH_TTL_DAYS=14
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_PATH=http://localhost:8000/api/v1

# Read-only market data provider. Placeholder credentials are never valid.
MARKET_DATA_PROVIDER=toss
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_REQUEST_TIMEOUT_SECONDS=10
TOSS_MAX_RETRIES=2
TOSS_TOKEN_EXPIRY_SKEW_SECONDS=30

# Enable this on exactly one API instance. All other web workers should use false.
SCHEDULER_ENABLED=false
WATCHLIST_JOB_HOUR=18
WATCHLIST_JOB_MINUTE=20
WATCHLIST_JOB_TIMEZONE=Asia/Seoul
WATCHLIST_JOB_MISFIRE_GRACE_SECONDS=3600
WATCHLIST_PIPELINE_STALE_AFTER_SECONDS=7200

# Optional event-driven Slack notifications. Leave blank to disable delivery.
SLACK_WEBHOOK_URL=
NOTIFICATION_TIMEOUT_SECONDS=5
NOTIFICATION_MAX_RETRIES=2
